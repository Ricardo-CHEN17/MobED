        <inertial pos="0.0016718354 -2.125219e-06 -0.028065513" mass="0.34155445" quat="0.9981442 4.7558172e-05 0.060894316 -0.00020962731" diaginertia="0.00021713852 0.00024338633 0.00028958694" />
