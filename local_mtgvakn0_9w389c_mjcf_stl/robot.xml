    <geom name="floor" type="plane" size="10 10 0.1" pos="0 0 0" />

    <!-- 机器人 Base: 初始高度抬高 0.2m 防止卡进地面 -->
    <body name="chassis" pos="0 0 0.25">
      <!-- 浮动基座：允许车身在空间中 6 自由度运动 -->
      <freejoint name="root" />

      <inertial pos="0.0019047851 0 0.049093719" mass="14.996783" quat="1 0 0 0" diaginertia="0.20788229 0.20788229 0.39976801" />
      <geom name="chassis_mesh_1" type="mesh" mesh="part_001_solid_001" pos="0 0.0090937195 0.0019047852" euler="0 0 0" group="1" />
      
      <!-- IMU 传感器挂载点 -->
      <site name="imu_site" pos="0 0 0.05" size="0.01" />

      <!-- ==================== Front Left (FL) ==================== -->
      <body name="Steering_joint_LF" pos="0.15190479 0.15 0.0090937195" euler="0 0 1.5707963">
