        <inertial pos="-0.001671834 2.124541e-06 -0.028065513" mass="0.34155445" quat="0.9981442 -4.7524281e-05 -0.060894306 -0.00020970841" diaginertia="0.00021713852 0.00024338633 0.00028958695" />
