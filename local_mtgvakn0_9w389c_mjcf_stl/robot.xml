  <!-- ==================== 执行器定义 ==================== -->
  <actuator>
    <!-- 1. 转向关节：使用内置 position 控制器 (PD) 跟踪期望角度 -->
    <position name="act_steer_FL" joint="Steering_joint_LF" kp="100" kv="5" forcerange="-30 30" />
    <position name="act_steer_FR" joint="Steering_joint_RF" kp="100" kv="5" forcerange="-30 30" />
    <position name="act_steer_RL" joint="Steering_joint_LB" kp="100" kv="5" forcerange="-30 30" />
    <position name="act_steer_RR" joint="Steering_joint_RB" kp="100" kv="5" forcerange="-30 30" />

    <!-- 2. 轮子驱动关节：使用 velocity 控制器跟踪期望角速度 (PI) -->
    <velocity name="act_wheel_FL" joint="Wheel_joint_LF" kv="5" forcerange="-30 30" />
    <velocity name="act_wheel_FR" joint="Wheel_joint_RF" kv="5" forcerange="-30 30" />
    <velocity name="act_wheel_RL" joint="Wheel_joint_LB" kv="5" forcerange="-30 30" />
    <velocity name="act_wheel_RR" joint="Wheel_joint_RB" kv="5" forcerange="-30 30" />

    <!-- 3. 偏心姿态关节：配置为直接力矩控制 (motor)，以便后续下发 GRF 优化和姿态力矩 -->
    <motor name="act_ecc_FL" joint="Posture_control_joint_LF" forcerange="-50 50" />
    <motor name="act_ecc_FR" joint="Posture_control_joint_RF" forcerange="-50 50" />
    <motor name="act_ecc_RL" joint="Posture_control_joint_LB" forcerange="-50 50" />
    <motor name="act_ecc_RR" joint="Posture_control_joint_RB" forcerange="-50 50" />
  </actuator>

  <!-- ==================== 传感器定义 ==================== -->
  <sensor>
    <framelinvel name="body_vel" objtype="site" objname="imu_site" />
    <gyro name="body_gyro" site="imu_site" />
    <accelerometer name="body_acc" site="imu_site" />
    <framequat name="body_quat" objtype="site" objname="imu_site" />
  </sensor>
</mujoco>