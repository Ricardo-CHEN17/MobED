      <!-- ==================== Rear Left (RL) ==================== -->
      <body name="Steering_joint_LB" pos="-0.14809521 0.15 0.0090937195" euler="0 0 1.5707963">
        <joint name="Steering_joint_LB" type="hinge" pos="0 0 0" axis="0 0 1" />
        <inertial pos="0.0016718342 -2.1248196e-06 -0.028065513" mass="0.34155446" quat="0.9981442 4.7518247e-05 0.060894305 -0.00020975219" diaginertia="0.00021713853 0.00024338634 0.00028958696" />
