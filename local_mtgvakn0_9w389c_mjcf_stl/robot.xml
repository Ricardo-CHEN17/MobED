        <body name="Posture_control_joint_LF" pos="0.046069665 0 -0.045" euler="-1.5707963 -1.5707963 0">
          <joint name="Posture_control_joint_LF" type="hinge" pos="0 0 0" axis="0 0 1" />
          <inertial pos="-0.035491101 -0.01210916 -0.013991309" mass="0.035399978" quat="0.98651643 0 0 0.16366223" diaginertia="2.7879217e-06 2.9222798e-05 3.142072e-05" />
          <geom name="Posture_control_joint_LF_mesh_1" type="mesh" mesh="part_003_solid_003" pos="0.15190479 -0.037811066 0.18697595" euler="1.5707963 0 -3.1415927" group="1" />
          
